#!/usr/bin/env bash
# gravito — the R0 lifecycle CLI (PKT-R0-3/4/5). Wraps existing machinery
# (install-project.sh, init-build-os.sh, authority-envelope.sh, the namespace
# guard); it invents no new state formats. Every mutating verb writes a
# manifest/receipt, is idempotent, and offers --dry-run; destructive verbs
# DEFAULT to dry-run and require --force. Honest surfaces only: numbers this
# repo does not meter are reported as "not metered", never invented.
#
#   gravito preflight [DIR]        read-only eligibility check
#   gravito init [DIR]             preflight + deterministic install + stamp + manifest
#   gravito status [DIR]           unified status/receipts surface
#   gravito update [DIR]           re-install engine files; manifest diff receipt
#   gravito rollback [DIR]         restore engine files from the PREVIOUS manifest
#   gravito uninstall [DIR]        remove ENGINE files (keeps build-os/ user data)  [dry-run default]
#   gravito purge [DIR]            remove ALL Gravito state from the repo          [dry-run default]
#   gravito goal <file> [DIR]      validate + install the goal contract (PKT-R0-4)
#   gravito run [DIR]              gate + dispatch ONE worker session; meters spend into the ledger
#   gravito review [DIR]           diff summary + acceptance (acceptance_cmd runs; prose is shown)
#   gravito health [DIR]           H0 system health facts + reachable actions (pre-work surface)
#   gravito predict <value> [DIR]  record a pre-run acceptance forecast (optional; enables delta)
#   gravito plan [DIR]             deterministic plan over the admitted action set (inspection)
#   gravito diagnose [DIR]         support bundle: identity, wiring, goal, ledger, receipts
#   gravito stop [DIR]             halt the worker at a safe boundary; state durable
set -euo pipefail
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CMD="${1:-help}"; shift || true
FORCE=0; DRY=0
ARGS=()
for a in "$@"; do case "$a" in --force) FORCE=1 ;; --dry-run) DRY=1 ;; *) ARGS+=("$a") ;; esac; done
set -- "${ARGS[@]:-}"

say(){ printf '%s\n' "$*"; }
die(){ printf 'gravito: %s\n' "$*" >&2; exit 1; }
now(){ date -u +%FT%TZ; }

resolve_dir(){ local d="${1:-$(pwd)}"; [ -d "$d" ] || die "no such directory: $d"; (cd "$d" && pwd); }
manifest_dir(){ printf '%s/build-os/receipts' "$1"; }
latest_manifest(){ ls -1 "$(manifest_dir "$1")"/install-manifest-*.txt 2>/dev/null | sort | tail -1; }

# Engine file inventory: exactly what install-project.sh copies.
engine_files(){ # <dest> -> repo-relative paths that ARE engine (not user data)
  local d="$1" f
  for f in "$d"/.claude/agents/*.md "$d"/.claude/commands/*.md "$d"/.claude/hooks/*.sh "$d"/.claude/hooks/mcp-readonly-allowlist.txt "$d"/build-os/tools/goal-check.sh "$d"/build-os/tools/h0-check.sh "$d"/build-os/tools/route-task.sh "$d"/build-os/tools/mode-select.mjs "$d"/CLAUDE.md; do
    [ -f "$f" ] && printf '%s\n' "${f#"$d"/}"
  done
}
write_manifest(){ # <dest> <label>
  local d="$1" mf
  mkdir -p "$(manifest_dir "$d")"
  mf="$(manifest_dir "$d")/install-manifest-$(date -u +%Y%m%dT%H%M%SZ)-$2.txt"
  { echo "# gravito install manifest — $2 at $(now)"
    engine_files "$d" | while read -r rel; do printf '%s  %s\n' "$(sha256sum "$d/$rel" | cut -d' ' -f1)" "$rel"; done
  } > "$mf"
  say "receipt: ${mf#"$d"/}"
}

cmd_preflight(){
  local d; d="$(resolve_dir "${1:-}")"; local failed=0
  chk(){ if eval "$2"; then say "  ok   $1"; else say "  FAIL $1"; failed=1; fi }
  say "gravito preflight — $d (read-only)"
  chk "is a git repository"                'git -C "$d" rev-parse --git-dir >/dev/null 2>&1'
  chk "not the Build OS source repo"       '[ "$d" != "$SRC" ]'
  chk "working tree readable"              '[ -r "$d" ]'
  chk "no foreign-project namespace stamp" '! { [ -f "$d/build-os/memory/.project-identity" ] && source "$SRC/.claude/hooks/project-identity.sh" && [ "$(bosi_namespace_verdict "$d")" = "QUARANTINE" ]; }'
  chk "no obvious secret files at root"    '! ls "$d"/.env "$d"/*.pem 2>/dev/null | grep -q .'
  [ "$failed" -eq 0 ] && say "preflight: ELIGIBLE" || { say "preflight: REFUSED — resolve the FAIL lines first"; return 1; }
}

cmd_init(){
  local d; d="$(resolve_dir "${1:-}")"
  cmd_preflight "$d" || die "init refused by preflight"
  [ "$DRY" -eq 1 ] && { say "dry-run: would install engine + scaffold + stamp into $d"; return 0; }
  "$SRC/install-project.sh" "$d" >/dev/null
  ( cd "$d" && "$SRC/init-build-os.sh" >/dev/null )
  write_manifest "$d" init
  say "init: complete (idempotent — re-running converges to the same manifest hashes)"
}

cmd_update(){
  local d; d="$(resolve_dir "${1:-}")"
  [ -n "$(latest_manifest "$d")" ] || die "no install manifest — run 'gravito init' first"
  [ "$DRY" -eq 1 ] && { say "dry-run: would re-copy engine files and write a manifest"; return 0; }
  "$SRC/install-project.sh" "$d" >/dev/null
  write_manifest "$d" update
  say "update: complete"
}

cmd_rollback(){
  local d; d="$(resolve_dir "${1:-}")"
  local mfs prev
  mfs="$(ls -1 "$(manifest_dir "$d")"/install-manifest-*.txt 2>/dev/null | sort)"
  prev="$(printf '%s\n' "$mfs" | tail -2 | head -1)"
  [ -n "$prev" ] && [ "$prev" != "$(printf '%s\n' "$mfs" | tail -1)" ] || die "no previous manifest to roll back to"
  say "rollback target: ${prev#"$d"/}"
  say "NOTE: rollback restores ENGINE files only; it never touches product code or build-os/ user data."
  [ "$DRY" -eq 1 ] && { say "dry-run: would verify/restore files listed above"; return 0; }
  # R0 semantics: engine files come from the source repo; rollback = re-copy
  # then verify against the previous manifest's hashes, reporting drift.
  "$SRC/install-project.sh" "$d" >/dev/null
  local drift=0
  while read -r h rel; do
    [ -n "$rel" ] || continue
    case "$h" in \#*) continue ;; esac
    if [ ! -f "$d/$rel" ] || [ "$(sha256sum "$d/$rel" | cut -d' ' -f1)" != "$h" ]; then say "  drift vs previous manifest: $rel"; drift=1; fi
  done < "$prev"
  write_manifest "$d" rollback
  [ "$drift" -eq 0 ] && say "rollback: engine matches the previous manifest" || say "rollback: completed with drift noted above (engine source has moved on — expected after upstream updates)"
}

cmd_uninstall(){
  local d; d="$(resolve_dir "${1:-}")"
  local mf; mf="$(latest_manifest "$d")"
  [ -n "$mf" ] || die "no install manifest — nothing recorded to uninstall"
  say "uninstall plan (engine only; build-os/ user data KEPT):"
  awk '!/^#/ {print "  rm " $2}' "$mf"
  if [ "$FORCE" -ne 1 ]; then say "dry-run (default). Re-run with --force to execute."; return 0; fi
  awk '!/^#/ {print $2}' "$mf" | while read -r rel; do rm -f "$d/$rel"; done
  find "$d/.claude" -type d -empty -delete 2>/dev/null || true
  say "uninstall: engine removed at $(now); user data intact. Receipt kept: ${mf#"$d"/}"
}

cmd_purge(){
  local d; d="$(resolve_dir "${1:-}")"
  say "purge plan — COMPLETE local Gravito data removal for this repo:"
  say "  rm -rf .claude/  build-os/  gravito.goal (if present)"
  say "  strip the GRAVITO:MANAGED block from .gitignore and the test:build-os-memory script from package.json (if present)"
  say "  (product files are never touched; this cannot be undone)"
  if [ "$FORCE" -ne 1 ]; then say "dry-run (default). Re-run with --force to execute."; return 0; fi
  rm -rf "$d/.claude" "$d/build-os" "$d/gravito.goal"
  # The installer appends ONE marked block to .gitignore (archive visibility).
  # With build-os/ gone that block is dead Gravito state: remove exactly it.
  if [ -f "$d/.gitignore" ] && grep -q '^# GRAVITO:MANAGED' "$d/.gitignore"; then
    awk '{a[NR]=$0}
      END{
        s=0; for(i=1;i<=NR;i++) if(a[i] ~ /^# GRAVITO:MANAGED/){s=i; break}
        if(s==0){for(i=1;i<=NR;i++)print a[i]; exit}
        e=s; while(e<=NR && a[e]!="!build-os/memory/archive/") e++
        b=s; if(b>1 && a[b-1]=="") b--
        for(i=1;i<b;i++)print a[i]
        for(i=e+1;i<=NR;i++)print a[i]
      }' "$d/.gitignore" > "$d/.gitignore.tmp"
    mv "$d/.gitignore.tmp" "$d/.gitignore"
    [ -s "$d/.gitignore" ] || rm -f "$d/.gitignore"
    say "purge: GRAVITO:MANAGED block stripped from .gitignore"
  fi
  if [ -f "$d/package.json" ] && command -v python3 >/dev/null 2>&1; then
    python3 - "$d/package.json" <<'PY'
import json, sys
path = sys.argv[1]
with open(path) as f: pkg = json.load(f)
s = pkg.get("scripts", {})
if s.get("test:build-os-memory") == "./build-os/maintenance/run-tests.sh":
    del s["test:build-os-memory"]
    if not s: del pkg["scripts"]
    with open(path, "w") as f: json.dump(pkg, f, indent=2); f.write("\n")
    print("purge: test:build-os-memory script removed from package.json")
PY
  fi
  say "purge: all Gravito state removed at $(now)"
}

cmd_goal(){
  local f="${1:-}"; local d; d="$(resolve_dir "${2:-}")"
  [ -n "$f" ] && [ -f "$f" ] || die "usage: gravito goal <file> [DIR] — see templates/gravito.goal.example"
  bash "$SRC/build-os/tools/goal-check.sh" "$f" || die "goal contract INVALID — fix the errors above; nothing installed"
  [ "$DRY" -eq 1 ] && { say "dry-run: goal valid; would install to $d/gravito.goal"; return 0; }
  cp "$f" "$d/gravito.goal"
  say "goal installed: $d/gravito.goal (budget halts enforced per contract; see 'gravito status')"
}

cmd_status(){
  local d; d="$(resolve_dir "${1:-}")"
  say "=== gravito status — $d @ $(now) ==="
  if [ -r "$SRC/.claude/hooks/project-identity.sh" ]; then
    source "$SRC/.claude/hooks/project-identity.sh"
    say "namespace: $(bosi_namespace_verdict "$d") (id $(bosi_project_id "$d"))"
  fi
  if [ -f "$d/gravito.goal" ]; then
    say "goal: $(awk -F': ' '$1=="goal"{print $2; exit}' "$d/gravito.goal")"
    say "authority: $(awk -F': ' '$1=="authority"{print $2; exit}' "$d/gravito.goal") | expiry: $(awk -F': ' '$1=="expires"{print $2; exit}' "$d/gravito.goal")"
    bash "$SRC/build-os/tools/goal-check.sh" --status "$d/gravito.goal" || true
  else
    say "goal: none installed (gravito goal <file>)"
  fi
  say "state: $( [ -f "$d/build-os/packets/active_packet.md" ] && grep -m1 '^- \*\*Status:\*\*' "$d/build-os/packets/active_packet.md" || echo 'no active packet' )"
  local nw; nw="$(pgrep -fc 'claude -p' 2>/dev/null)" || nw=0
  say "workers: ${nw:-0} headless worker session(s) on this host"
  local mf; mf="$(latest_manifest "$d")"
  say "install: ${mf:+manifest $(basename "$mf")}${mf:-not installed via gravito init}"
  say "last receipts:"; ls -1t "$d"/build-os/receipts/*.md 2>/dev/null | head -3 | sed 's/^/  /' || true
  local ledger="$d/build-os/memory/spend-ledger.jsonl"
  if [ -f "$ledger" ]; then
    say "spend (committed ledger, 'gravito run' streams only): $(awk -F'"tokens":' 'NF>1{split($2,a,/[,}]/); s+=a[1]} END{printf "%d", s}' "$ledger")tok \$$(awk -F'"usd":' 'NF>1{split($2,a,/[,}]/); s+=a[1]} END{printf "%.2f", s}' "$ledger") $(awk -F'"minutes":' 'NF>1{split($2,a,/[,}]/); s+=a[1]} END{printf "%d", s}' "$ledger")min across $(grep -c . "$ledger") run(s)"
  else
    say "spend: no metered runs recorded yet (the ledger is written by 'gravito run')"
  fi
  say "NOT METERED (stated, not inferred): operator interactive sessions, experiment harnesses, direct 'claude' invocations outside 'gravito run', MCP-side execution"
  say "interventions: NOT METERED in R0.x (R1 telemetry logger)"
  say "pending approvals: check the conversation — external mutation always awaits an explicit operator go"
  say "stop:     interrupt the session or let the current step finish (state is durable; resume by re-invoking)"
  say "rollback: gravito rollback $d   |   uninstall: gravito uninstall $d [--force]   |   purge: gravito purge $d [--force]"
}

cmd_health(){
  # Zone 2+3 operator surface: H0_system facts + explicit reachable actions.
  local d; d="$(resolve_dir "${1:-}")"
  bash "$SRC/build-os/tools/h0-check.sh" "$d" || true
  node "$SRC/build-os/tools/reachability.mjs" "$d"
}

cmd_run(){
  local d; d="$(resolve_dir "${1:-}")"
  # CANONICAL SEQUENCE, traced with one correlation id per dispatch attempt:
  # state -> H0 (full surface, once) -> reachability construction (executable
  # + feasible facts, once) -> authority/admissibility (the SAME goal gate,
  # invoked ONCE, inside the construction — reachability contains no policy
  # of its own) -> admission (dispatch only if 'run' is in R_t+) -> dispatch.
  # Every refusal happens BEFORE any side effect (no pid, no stream).
  local run_id trace; run_id="run-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$d/build-os/receipts"; trace="$d/build-os/receipts/run-trace.jsonl"
  tr_step(){ printf '{"run_id":"%s","seq":%d,"step":"%s","detail":%s}\n' "$run_id" "$1" "$2" "$3" >> "$trace"; }
  local h0rc=0; bash "$SRC/build-os/tools/h0-check.sh" "$d" >/dev/null 2>&1 || h0rc=$?
  local agency; agency="$(python3 -c "import json;print(json.load(open('$d/build-os/receipts/h0-latest.json'))['agency'])" 2>/dev/null || echo unknown)"
  tr_step 1 h0 "\"agency=$agency\""
  if [ "$h0rc" -eq 4 ]; then
    tr_step 2 refuse "\"H0 Class-A block\""
    { bash "$SRC/build-os/tools/h0-check.sh" "$d" 2>&1 || true; } | grep "BLOCKED" >&2 || true
    die "H0_system Class-A block — see build-os/receipts/h0-latest.json"
  fi
  local reach admitted reason gate
  reach="$(node "$SRC/build-os/tools/reachability.mjs" --json "$d" 2>/dev/null)" || die "reachability construction failed"
  admitted="$(printf '%s' "$reach" | python3 -c "import json,sys;r=json.load(sys.stdin);print('yes' if 'run' in r['R_t_plus'] else 'no')")"
  reason="$(printf '%s' "$reach" | python3 -c "import json,sys;r=json.load(sys.stdin);print(next(a['reason'] for a in r['actions'] if a['a']=='run'))")"
  gate="$(printf '%s' "$reach" | python3 -c "import json,sys;print(json.load(sys.stdin)['gate'])")"
  tr_step 2 reachability "\"run_in_R_t_plus=$admitted\""
  tr_step 3 authority "$(printf '%s' "$gate" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')"
  if [ "$admitted" != "yes" ]; then
    tr_step 4 refuse "$(printf '%s' "$reason" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')"
    die "not dispatching — 'run' is outside R_t+: $reason"
  fi
  # Zone 4 — deterministic plan over the ADMITTED candidate. cmd_run has one
  # dispatchable work action, so this is an honest degenerate plan: no
  # comparison occurred and none is claimed. Class-A facts (HEAD, goal) are
  # revalidated by the planner's validate step immediately before dispatch.
  local planout plan_id plan_status
  planout="$(printf '%s' "$reach" | node "$SRC/build-os/tools/planner.mjs" plan --dir "$d" --run-id "$run_id" --origin cmd_run --candidates run --h0 "$agency")" || { tr_step 4 refuse "\"planner refused\""; die "planner refused — $planout"; }
  plan_status="$(printf '%s' "$planout" | python3 -c 'import json,sys;print(json.load(sys.stdin)["status"])')"
  plan_id="$(printf '%s' "$planout" | python3 -c 'import json,sys;d=json.load(sys.stdin);print(d["plan"]["content_hash"][:12] if d.get("plan") else "-")')"
  [ "$plan_status" = "PLANNED" ] || { tr_step 4 refuse "\"plan status $plan_status\""; die "no dispatch: plan status $plan_status"; }
  tr_step 4 plan "\"plan_id=$plan_id degenerate\""
  local reval
  reval="$(printf '%s' "$planout" | python3 -c 'import json,sys;print(json.dumps(json.load(sys.stdin)["plan"]))' | node --input-type=module -e "
import { validatePlan } from '$SRC/build-os/tools/planner.mjs';
import fs from 'node:fs';
const p = JSON.parse(fs.readFileSync(0,'utf8'));
const v = validatePlan('$d', p);
console.log(v.ok ? 'ok' : 'STALE: ' + v.reason);
")"
  [ "$reval" = "ok" ] || { tr_step 5 refuse "\"$reval\""; die "no dispatch: $reval"; }
  [ "$DRY" -eq 1 ] && { tr_step 5 dry-run "\"planned+revalidated, no dispatch\""; say "dry-run: gate open; would dispatch one worker session"; return 0; }
  tr_step 5 dispatch "\"worker session plan_id=$plan_id\""
  local ts prompt stream started
  ts="$(date -u +%Y%m%dT%H%M%SZ)"; stream="$d/build-os/receipts/run-$ts.jsonl"
  prompt="$(printf '# Goal (from gravito.goal — the binding contract)\n%s\n\nAuthority: %s\nProhibited: %s\nAcceptance: %s\n\nWork ONLY in this repository. Never push, merge, deploy, or touch secrets. Deliver the work, state the outcome once, stop.' \
    "$(awk -F': ' '$1=="goal"{sub(/^[^:]*: /,"");print;exit}' "$d/gravito.goal")" \
    "$(awk -F': ' '$1=="authority"{sub(/^[^:]*: /,"");print;exit}' "$d/gravito.goal")" \
    "$(awk -F': ' '$1=="prohibited_actions"{sub(/^[^:]*: /,"");print;exit}' "$d/gravito.goal")" \
    "$(awk -F': ' '$1=="acceptance"{sub(/^[^:]*: /,"");print;exit}' "$d/gravito.goal")")"
  started="$(date +%s)"
  local snap; snap="$(mktemp)"; bash "$SRC/build-os/tools/residue-sweep.sh" snapshot "$d" > "$snap"
  say "run: dispatching one worker session (stream → ${stream#"$d"/})"
  ( cd "$d" && printf '%s' "$prompt" | claude -p --output-format stream-json --verbose --permission-mode acceptEdits > "$stream" 2>"$d/build-os/receipts/run-$ts.err" ) &
  echo $! > "$d/build-os/receipts/run.pid"
  wait "$(cat "$d/build-os/receipts/run.pid")" || true
  rm -f "$d/build-os/receipts/run.pid"
  bash "$SRC/build-os/tools/meter-run.sh" "$stream" "$d" "$(( $(date +%s) - started ))"
  bash "$SRC/build-os/tools/residue-sweep.sh" sweep "$d" "$snap"; rm -f "$snap"
  say "run: complete — 'gravito review $d' next"
}

cmd_plan(){
  # Zone 4 operator surface: deterministic plan over the FULL admitted action
  # set (multi-candidate ordering, lexicographic policy). Inspection surface;
  # executing anything remains each verb's own path.
  local d; d="$(resolve_dir "${1:-}")"
  local reach; reach="$(node "$SRC/build-os/tools/reachability.mjs" --json "$d" 2>/dev/null)" || die "reachability construction failed"
  local out; out="$(printf '%s' "$reach" | node "$SRC/build-os/tools/planner.mjs" plan --dir "$d" --run-id "plan-$(date -u +%Y%m%dT%H%M%SZ)-$$" --origin cmd_plan)" || { say "$out"; die "planner refused"; }
  printf '%s' "$out" | python3 -c '
import json,sys
d=json.load(sys.stdin)
if d["status"]!="PLANNED":
    print("plan:", d["status"], "-", d.get("refusal","")); sys.exit(0)
p=d["plan"]
print(f"plan {p["content_hash"][:12]} — {p["candidates_admitted"]} admitted candidate(s)" + (" (degenerate)" if p["degenerate"] else ""))
print(f"  selected: {p["selected"]}")
for o in p["ordered"]: print(f"  {o["rank"]}. {o["action"]:<10} dep={o["dependency_satisfied"]} evidence={o["produces_evidence"]} reversible={o["reversible"]} blast={o["blast_radius"]}")
unsafe=[x for x in p["parallel_classification"] if x["class"]!="safely_parallel"]
print(f"  parallel: {sum(1 for x in p["parallel_classification"] if x["class"]=="safely_parallel")} safe pair(s); {len(unsafe)} conflicting/unknown (unknown is never safe)")
print(f"  verification: {p["required_verification"]}")
print(f"  cognition handoff: {p["cognition_requirement"]["state"]} — consumer UCDL UNWIRED (descriptor only)")
'
}

cmd_predict(){
  # Zone 7 pre-action surface: record a FORECAST before running. Optional by
  # design — a missing prediction is later recorded NOT_RECORDED, never
  # invented from the goal (a success criterion is not yhat).
  local val="${1:-}"; local d; d="$(resolve_dir "${2:-}")"
  [ -n "$val" ] || die "usage: gravito predict '<predicted acceptance value: PASS|FAIL|...>' [DIR]"
  local id; id="$(bash "$SRC/build-os/tools/delta-receipt.sh" predict "$d" --var acceptance --value "$val" --scale task --by operator)" || die "prediction not recorded"
  say "prediction recorded: $id (outcome_var=acceptance, predicted=$val)"
}

cmd_review(){
  # Zone 7 boundary (execution -> evidence). The acceptance result is
  # recorded as an OBSERVATION (outcome_var=acceptance) in the immutable
  # chain. delta is computed ONLY against a prediction actually made
  # beforehand via 'gravito predict' — never manufactured from the goal.
  # Zone 9 counters REPORT after (Class-B diagnostics; they grade nothing).
  local d; d="$(resolve_dir "${1:-}")"
  say "=== gravito review — $d ==="
  say "-- changes since HEAD:"; git -C "$d" status --short | sed 's/^/  /' | head -20
  local cmd verdict rc=0 predid=""
  # newest acceptance prediction not yet referenced by any observation
  if [ -f "$d/build-os/receipts/predictions.jsonl" ]; then
    predid="$(python3 - "$d" <<'PY'
import json, os, sys
d = sys.argv[1]
preds = []
for raw in open(os.path.join(d, "build-os/receipts/predictions.jsonl")):
    try: p = json.loads(raw)
    except Exception: continue
    if p.get("outcome_var") == "acceptance": preds.append(p["id"])
used = set()
df = os.path.join(d, "build-os/receipts/deltas.jsonl")
if os.path.exists(df):
    for raw in open(df):
        try: used.add(json.loads(raw).get("prediction_id"))
        except Exception: pass
free = [p for p in preds if p not in used]
print(free[-1] if free else "")
PY
)"
  fi
  cmd="$(awk -F': ' '$1=="acceptance_cmd"{sub(/^[^:]*: /,"");print;exit}' "$d/gravito.goal" 2>/dev/null)"
  if [ -n "$cmd" ]; then
    say "-- acceptance_cmd: $cmd"
    if ( cd "$d" && bash -c "$cmd" >/dev/null 2>&1 ); then verdict="PASS"; say "acceptance: PASS"; else verdict="FAIL"; say "acceptance: FAIL"; rc=1; fi
    bash "$SRC/build-os/tools/delta-receipt.sh" observe "$d" \
      --var acceptance --observed "$verdict" \
      --evidence "acceptance_cmd: $cmd" \
      ${predid:+--prediction-id "$predid"} \
      --alternative "flaky-acceptance-or-incomplete-work-see-diff" \
      --scale task --consequence none >/dev/null || say "delta receipt: append failed — see stream"
  else
    say "-- acceptance (human judgment): $(awk -F': ' '$1=="acceptance"{sub(/^[^:]*: /,"");print;exit}' "$d/gravito.goal" 2>/dev/null)"
    bash "$SRC/build-os/tools/delta-receipt.sh" observe "$d" \
      --var acceptance --observed "human-judgment-displayed" \
      --evidence "no acceptance_cmd in contract" \
      ${predid:+--prediction-id "$predid"} \
      --alternative "human-judgment path has no mechanical verdict" \
      --scale task --consequence none >/dev/null || true
  fi
  say "-- program signals (diagnostics only — these grade nothing):"
  node "$SRC/build-os/tools/convergence-counters.mjs" "$d" 2>/dev/null | sed 's/^/  /' || true
  return $rc
}

cmd_diagnose(){
  # R1-P3 — one support bundle: everything needed to debug a target repo
  # without expert archaeology. Read-only except the bundle receipt itself.
  local d; d="$(resolve_dir "${1:-}")"
  local ts out
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$d/build-os/receipts"
  out="$d/build-os/receipts/diagnose-$ts.txt"
  {
    echo "=== gravito diagnose — $d @ $(now) ==="
    echo "engine source: $SRC"
    if [ -r "$SRC/.claude/hooks/project-identity.sh" ]; then
      source "$SRC/.claude/hooks/project-identity.sh"
      echo "namespace: $(bosi_namespace_verdict "$d") (id $(bosi_project_id "$d"))"
    fi
    echo "-- engine files (missing = broken install; fix: gravito update)"
    local rel missing=0
    for rel in .claude/hooks/routing-gate.sh .claude/hooks/session-start-build-os.sh .claude/hooks/mcp-readonly-allowlist.txt build-os/tools/goal-check.sh build-os/tools/route-task.sh CLAUDE.md; do
      [ -f "$d/$rel" ] || { echo "  MISSING: $rel"; missing=1; }
    done
    [ "$missing" -eq 0 ] && echo "  all present"
    echo "-- tool-gate wiring in .claude/settings.json (unwired = enforcement is NOT live)"
    if [ -f "$d/.claude/settings.json" ] && command -v python3 >/dev/null 2>&1; then
      python3 - "$d/.claude/settings.json" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
pt = s.get("hooks", {}).get("PreToolUse", [])
want = {"Edit|Write|NotebookEdit|Bash": "mutgate", "mcp__.*": "mcpgate", "Task|Agent": "gate"}
for m, mode in want.items():
    ok = any(g.get("matcher") == m and any(("routing-gate.sh " + mode) in h.get("command", "") for h in g.get("hooks", [])) for g in pt)
    print("  %s %s -> %s" % ("wired  " if ok else "UNWIRED", m, mode))
PY
    else
      echo "  cannot inspect (no settings.json or no python3)"
    fi
    echo "-- goal"
    if [ -f "$d/gravito.goal" ]; then
      bash "$SRC/build-os/tools/goal-check.sh" --status "$d/gravito.goal" || true
    else
      echo "  none installed"
    fi
    echo "-- spend ledger"
    local ledger="$d/build-os/memory/spend-ledger.jsonl"
    if [ -f "$ledger" ]; then
      echo "  $(grep -c . "$ledger") entries; last: $(tail -1 "$ledger" | cut -c1-160)"
    else
      echo "  no metered runs recorded"
    fi
    echo "-- last refusals (empty = nothing was ever blocked)"
    { tail -3 "$d/build-os/receipts/refusals.log" 2>/dev/null || true; } | sed 's/^/  /'
    echo "-- last receipts"
    { ls -1t "$d"/build-os/receipts/install-manifest-*.txt "$d"/build-os/receipts/run-*.jsonl 2>/dev/null || true; } | head -3 | sed 's/^/  /'
    echo "-- residue quarantine (empty = none)"
    { ls -1d "$d"/build-os/residue/*/ 2>/dev/null || true; } | sed 's/^/  /'
    echo "-- control wiring matrix (control | entry point | install state | status | evidence)"
    echo "   statuses: ABSENT / UPDATE_REQUIRED / IMPLEMENTED_UNWIRED /"
    echo "   STATICALLY_CONNECTED / WIRED_UNPROVEN / OUTCOME_PROVEN."
    echo "   A source line or installed file NEVER yields WIRED_*: an executed"
    echo "   invocation receipt from a supported path is required."
    echo "   OUTCOME_PROVEN additionally requires measured beneficial outcomes."
    _m_reg(){ python3 -c "
import json,sys
try: s=json.load(open('$d/.claude/settings.json'))
except Exception: sys.exit(1)
pt=s.get('hooks',{}).get('PreToolUse',[])
sys.exit(0 if any(g.get('matcher')=='Edit|Write|NotebookEdit|Bash' and any('mutgate' in h.get('command','') for h in g.get('hooks',[])) for g in pt) else 1)"; }
    row(){ printf "  %-22s %-11s %-18s %-20s %s\n" "$1" "$2" "$3" "$4" "$5"; }
    # H0 @ tool-gate — depends on the TARGET's install state
    if ! _m_reg; then
      row "H0_system" "tool-gate" "pre-R1(no matcher)" "ABSENT" "UNPROTECTED: no hook runs here; gravito update to protect"
    elif [ ! -x "$d/build-os/tools/h0-check.sh" ]; then
      row "H0_system" "tool-gate" "R1(no h0 tool)" "UPDATE_REQUIRED" "FAIL-CLOSED active: mutations refuse until gravito update"
    elif EV=$(grep "H0 " "$d/build-os/receipts/refusals.log" 2>/dev/null | tail -1) && [ -n "$EV" ]; then
      row "H0_system" "tool-gate" "current" "WIRED_UNPROVEN" "refusal receipt: ${EV%% tool=*}"
    else
      row "H0_system" "tool-gate" "current" "STATICALLY_CONNECTED" "matcher+tool present; no invocation receipt in this repo"
    fi
    # H0 @ cmd_run
    if [ -f "$d/build-os/receipts/h0-latest.json" ]; then
      row "H0_system" "cmd_run" "current" "WIRED_UNPROVEN" "receipt h0-latest.json @ $(python3 -c "import json;print(json.load(open('$d/build-os/receipts/h0-latest.json'))['at'])" 2>/dev/null || echo '?')"
    else
      row "H0_system" "cmd_run" "current" "STATICALLY_CONNECTED" "caller in CLI; no invocation receipt in this repo"
    fi
    # reachability: admission vs planner — SPLIT statuses, never one label
    if [ -f "$d/build-os/receipts/run-trace.jsonl" ] && grep -q '"step":"reachability"' "$d/build-os/receipts/run-trace.jsonl"; then
      row "reach.admission" "cmd_run" "current" "WIRED_UNPROVEN" "run-trace $(grep '"step":"reachability"' "$d/build-os/receipts/run-trace.jsonl" | tail -1 | python3 -c 'import json,sys;print(json.loads(sys.stdin.read())["run_id"])' 2>/dev/null || echo '?')"
    else
      row "reach.admission" "cmd_run" "current" "STATICALLY_CONNECTED" "admission caller in CLI; no run-trace in this repo"
    fi
    if [ -f "$d/build-os/receipts/plans.jsonl" ] && grep -q '"origin":"cmd_run"' "$d/build-os/receipts/plans.jsonl"; then
      row "planner" "cmd_run" "current" "WIRED_UNPROVEN" "plan receipt: $(grep '"origin":"cmd_run"' "$d/build-os/receipts/plans.jsonl" | tail -1 | python3 -c 'import json,sys;d=json.loads(sys.stdin.read());print(d["content_hash"][:12],d["run_id"])' 2>/dev/null || echo '?')"
    else
      row "planner" "cmd_run" "current" "STATICALLY_CONNECTED" "caller in CLI; no cmd_run plan receipt in this repo"
    fi
    if [ -f "$d/build-os/receipts/plans.jsonl" ] && grep -q '"origin":"cmd_plan"' "$d/build-os/receipts/plans.jsonl"; then
      row "planner" "cmd_plan" "current" "WIRED_UNPROVEN" "plan receipt exists (multi-candidate ordering executed)"
    else
      row "planner" "cmd_plan" "current" "STATICALLY_CONNECTED" "caller in CLI; no cmd_plan receipt in this repo"
    fi
    row "cognition-handoff" "planner" "n/a" "IMPLEMENTED_UNWIRED" "descriptor emitted in plans; consumer UCDL UNWIRED (the seam, not an invocation)"
    # delta streams
    if [ -f "$d/build-os/receipts/deltas.jsonl" ]; then
      row "delta.observe" "cmd_review" "current" "WIRED_UNPROVEN" "last: $(tail -1 "$d/build-os/receipts/deltas.jsonl" | python3 -c 'import json,sys;d=json.loads(sys.stdin.read());print(d["at"],d["prediction_status"])' 2>/dev/null || echo '?')"
    else
      row "delta.observe" "cmd_review" "current" "STATICALLY_CONNECTED" "caller in CLI; no observation receipt in this repo"
    fi
    if [ -f "$d/build-os/receipts/predictions.jsonl" ]; then
      row "delta.predict" "cmd_predict" "current" "WIRED_UNPROVEN" "$(grep -c . "$d/build-os/receipts/predictions.jsonl") forecast(s)"
    else
      row "delta.predict" "cmd_predict" "current" "STATICALLY_CONNECTED" "caller in CLI; no forecast recorded in this repo"
    fi
    row "convergence" "cmd_review" "current" "STATICALLY_CONNECTED" "report-only diagnostics; leaves no invocation receipt by design"
    echo "  uncovered/unsupported boundaries: bare human shell; pre-R1 targets"
    echo "  with unregistered matchers; experiment harnesses bypassing gravito;"
    echo "  sessions in unmanaged (non-Gravito) repositories."
    if [ -f "$d/build-os/receipts/deltas.jsonl" ] || [ -f "$d/build-os/receipts/predictions.jsonl" ]; then
      bash "$SRC/build-os/tools/delta-receipt.sh" verify "$d" 2>/dev/null | sed 's/^/  /' || true
    fi
    local nw; nw="$(pgrep -fc 'claude -p' 2>/dev/null)" || nw=0
    echo "-- workers on this host: ${nw:-0}"
  } | tee "$out"
  say ""
  say "diagnose bundle written: ${out#"$d"/}"
}

cmd_stop(){
  local d; d="$(resolve_dir "${1:-}")"
  if [ -f "$d/build-os/receipts/run.pid" ] && kill -0 "$(cat "$d/build-os/receipts/run.pid")" 2>/dev/null; then
    kill "$(cat "$d/build-os/receipts/run.pid")" 2>/dev/null || true
    rm -f "$d/build-os/receipts/run.pid"
    say "stop: worker halted at a safe boundary; state is durable (streams + ledger under build-os/). Resume: gravito run $d"
  else
    say "stop: no worker running; state durable. Resume: gravito run $d"
  fi
}

case "$CMD" in
  preflight) cmd_preflight "$@" ;;
  init)      cmd_init "$@" ;;
  status)    cmd_status "$@" ;;
  update)    cmd_update "$@" ;;
  rollback)  cmd_rollback "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  purge)     cmd_purge "$@" ;;
  goal)      cmd_goal "$@" ;;
  run)       cmd_run "$@" ;;
  health)    cmd_health "$@" ;;
  predict)   cmd_predict "$@" ;;
  plan)      cmd_plan "$@" ;;
  review)    cmd_review "$@" ;;
  diagnose)  cmd_diagnose "$@" ;;
  stop)      cmd_stop "$@" ;;
  help|*)    sed -n '2,23p' "$0" ;;
esac
