@@ -1163,6 +1198,43 @@ export const geometryAdminRouter = router({
 
 // ─── Helper Functions ──────────────────────────────────────────────
 
+/**
+ * Resolve the Drizzle handle for a DB-backed procedure.
+ *
+ * `getDb()` returns null when DATABASE_URL is unconfigured, so every procedure
+ * that reads geometry tables narrows through here and surfaces the outage as a
+ * tRPC error instead of dereferencing a null connection.
+ */
+async function requireDb(): Promise<NonNullable<Awaited<ReturnType<typeof getDb>>>> {
+  const db = await getDb();
+  if (!db) {
+    throw new TRPCError({
+      code: 'PRECONDITION_FAILED',
+      message: 'Database unavailable: geometry admin data requires a configured database',
+    });
+  }
+  return db;
+}
+
+/**
+ * Project a flat geometry state snapshot onto the canonical state the
+ * neurocosmology hooks consume. Mirrors the mapping used by the governed
+ * generation pipeline so diagnostic runs exercise the same code path.
+ */
+function buildCanonicalState(
+  snapshot: Record<string, number> | undefined,
+  sessionId: string,
+  userId: string,
+): CanonicalEmotionalState {
+  return updateBaseDimensions(createInitialState(sessionId, userId), {
+    emotionalMass: snapshot?.emotionalMass ?? 0,
+    valenceCharge: snapshot?.emotionalValence ?? snapshot?.emotionalCharge ?? 0,
+    attentionCurvature: snapshot?.attentionCurvature ?? 0,
+    memoryEntropy: snapshot?.memoryEntropy ?? 0.5,
+    relationalDistance: snapshot?.emotionalDistance ?? 1,
+  });
+}
