+// ============================================================================
+// TYPED VIEWS OVER UNTRUSTED / MIDDLEWARE-ATTACHED VALUES
+// ============================================================================
+
+/** Fields attached to the Express request by the MCP auth middleware. */
+interface McpAuthenticatedRequest extends Request {
+  authMethod?: string;
+  authUserId?: number;
+  apiKey?: string;
+}
+
+function mcpAuthRequest(req: Request): McpAuthenticatedRequest {
+  return req as McpAuthenticatedRequest;
+}
+
+/** JSON-RPC `params.arguments` after transport decoding: keys known, values not. */
+type ToolCallArguments = Record<string, unknown>;
+
+function toolCallArguments(value: unknown): ToolCallArguments {
+  return typeof value === 'object' && value !== null ? (value as ToolCallArguments) : {};
+}
+
+/**
+ * Narrow an unknown value to a non-empty string, mirroring the `||` chains that
+ * fall through empty strings to the next candidate.
+ */
+function readString(value: unknown): string | undefined {
+  return typeof value === 'string' && value.length > 0 ? value : undefined;
+}
+
+/** Narrow an unknown value to a finite number. */
+function readNumber(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;
+}
+
+/**
+ * JSON Schema fragment emitted for MCP tool discovery. Only the subset of
+ * keywords this handler produces is modelled.
+ */
+interface JsonSchemaNode {
+  type?: string;
+  description?: string;
+  enum?: unknown[];
+  properties?: Record<string, JsonSchemaNode>;
+  required?: string[];
+  items?: JsonSchemaNode;
+  default?: unknown;
+}
+
+/**
+ * Structural view of the Zod internals the converter reads. Zod 4 tags defs
+ * with `type`/`entries`; Zod 3 used `typeName`/`values`. Both are probed so the
+ * converter keeps working across the versions in the dependency tree.
+ */
+interface ZodSchemaDef {
+  type?: unknown;
+  typeName?: unknown;
+  entries?: Record<string, unknown>;
+  values?: unknown;
+  innerType?: unknown;
+  defaultValue?: unknown;
+}
+
+interface ZodSchemaLike {
+  description?: unknown;
+  parse?: unknown;
+  _def?: ZodSchemaDef;
+}
+
+function asZodSchemaLike(value: unknown): ZodSchemaLike | undefined {
+  return typeof value === 'object' && value !== null ? (value as ZodSchemaLike) : undefined;
+}
+
+/** True when a tool's `inputSchema` carries Zod internals rather than plain JSON Schema. */
+function hasZodDef(value: unknown): boolean {
+  return typeof asZodSchemaLike(value)?._def === 'object';
+}
+
+/** Coerce a Zod enum's `values`/`entries` container into a JSON Schema `enum` list. */
+function enumMemberList(values: unknown): unknown[] | undefined {
+  if (Array.isArray(values)) return values;
+  if (values instanceof Set) return Array.from(values);
+  if (typeof values === 'object' && values !== null) return Object.values(values);
+  return undefined;
+}
