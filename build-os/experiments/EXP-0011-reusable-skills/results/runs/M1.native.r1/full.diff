+// ============================================================================
+// HELPERS: Narrow untyped JSON-RPC args to the shapes downstream APIs declare
+// ============================================================================
+
+/** Coerce an arg to a string, matching template-literal semantics (nullish → ''). */
+function asText(value: unknown): string {
+  if (typeof value === 'string') return value;
+  if (value === undefined || value === null) return '';
+  return String(value);
+}
+
+/** Coerce an arg to a number; non-numeric, non-finite and zero values fall back. */
+function asNumber(value: unknown, fallback: number): number {
+  const n = typeof value === 'number' ? value : typeof value === 'string' ? Number(value) : NaN;
+  return Number.isFinite(n) && n !== 0 ? n : fallback;
+}
+
+/** Narrow an arg to a plain JSON object. */
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** Narrow an arg to an array of strings, dropping non-string entries. */
+function asStringArray(value: unknown): string[] {
+  return Array.isArray(value) ? value.filter((entry): entry is string => typeof entry === 'string') : [];
+}
+
+/**
+ * Narrow a caller-supplied surface name against the gate's own surface lists.
+ * The lists are passed in so the source of truth stays in fail-closed-gate.
+ */
+function isKnownSurface(
+  value: string,
+  regulated: readonly string[],
+  advisory: readonly string[],
+): value is Surface {
+  return value === 'general' || regulated.includes(value) || advisory.includes(value);
+}
