+/** Drizzle handle, with the `null` that `getDb()` returns when no database is configured removed. */
+type AnalyticsDb = NonNullable<Awaited<ReturnType<typeof getDb>>>;
+
+/**
+ * Resolve the database handle, or throw if none is configured.
+ *
+ * `getDb()` returns `null` when DATABASE_URL is absent. Every caller below already
+ * runs inside a try/catch that logs and returns a safe empty result, so throwing
+ * here routes "no database" into that same degraded path instead of a null deref.
+ */
+async function requireDb(): Promise<AnalyticsDb> {
+  const db = await getDb();
+  if (!db) {
+    throw new DatabaseUnavailableError('Database unavailable: alert analytics requires a database connection');
+  }
+  return db;
+}
