+/**
+ * A key row as the dashboard needs it. The API types every column as optional
+ * (rows come back as `Partial<ApiKey>`) and serialises timestamps as strings,
+ * so rows are narrowed with `hasKeyIdentity` before they reach this card.
+ */
+type DashboardApiKey = {
+  id: number;
+  keyPrefix: string;
+  name?: string | null;
+  isActive?: boolean;
+  createdAt?: string | null;
+  lastUsedAt?: string | null;
+};
+
+/** A row is only actionable (copy / regenerate / delete) once it has an id and prefix. */
+function hasKeyIdentity<T extends { id?: number; keyPrefix?: string }>(
+  key: T,
+): key is T & { id: number; keyPrefix: string } {
+  return typeof key.id === "number" && typeof key.keyPrefix === "string";
+}
