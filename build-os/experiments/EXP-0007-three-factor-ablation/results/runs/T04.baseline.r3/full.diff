+/**
+ * A row from `apiKeys.list`, once we know it can actually be rendered.
+ *
+ * The server selects a column subset (`id, key_prefix, name, is_active,
+ * last_used_at, created_at`) and types the result `Partial<ApiKey>`, so every
+ * field arrives optional — and the timestamps arrive as ISO strings, not Dates.
+ * A row missing its id or prefix can't be shown, copied, regenerated, or
+ * deleted, so narrow it away instead of assuming the fields are present.
+ */
+type ApiKeySummary = {
+  id: number;
+  keyPrefix: string;
+  isActive: boolean;
+  createdAt: string;
+  /** Cosmetic — the card already falls back when either is absent. */
+  name?: string;
+  lastUsedAt?: string | null;
+};
+
+function isRenderableApiKey(key: Partial<ApiKeySummary>): key is ApiKeySummary {
+  return typeof key.id === "number"
+    && typeof key.keyPrefix === "string"
+    && typeof key.isActive === "boolean"
+    && typeof key.createdAt === "string";
+}
