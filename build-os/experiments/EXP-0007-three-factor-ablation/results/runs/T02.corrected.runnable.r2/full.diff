--- a/server/services/auto-apply-pipeline.ts
+++ b/server/services/auto-apply-pipeline.ts
@@ -38,9 +38,22 @@ function getDb() {
 // TYPES
 // ============================================================================
 
+const AUTO_APPLY_SEVERITIES = ['low', 'medium', 'high', 'critical'] as const;
+
+export type AutoApplySeverity = (typeof AUTO_APPLY_SEVERITIES)[number];
+
+/**
+ * Narrow a persisted severity value to the auto-apply severity union.
+ * `governanceSettings.autoApplyMaxSeverity` is a free-form varchar in the
+ * schema, so the stored string is validated here rather than assumed.
+ */
+function isAutoApplySeverity(value: unknown): value is AutoApplySeverity {
+  return AUTO_APPLY_SEVERITIES.some((severity) => severity === value);
+}
+
 export interface AutoApplyConfig {
   enabled: boolean;
-  maxSeverity: 'low' | 'medium' | 'high' | 'critical';
+  maxSeverity: AutoApplySeverity;
   activeProfile: string;
   profileLocked: boolean;
 }
@@ -165,7 +178,9 @@ export async function getAutoApplyConfig(): Promise<AutoApplyConfig> {
     const settings = rows[0];
     return {
       enabled: settings.autoApplyMode ?? false,
-      maxSeverity: (settings.autoApplyMaxSeverity as unknown) ?? 'medium',
+      maxSeverity: isAutoApplySeverity(settings.autoApplyMaxSeverity)
+        ? settings.autoApplyMaxSeverity
+        : 'medium',
       activeProfile: settings.activeProfile,
       profileLocked: settings.profileLocked,
     };

