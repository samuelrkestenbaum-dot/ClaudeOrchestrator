 // TYPES
 // ============================================================================
 
+type Severity = 'low' | 'medium' | 'high' | 'critical';
+
+const SEVERITY_LEVELS: readonly Severity[] = ['low', 'medium', 'high', 'critical'];
+
+/**
+ * Narrow the DB's plain `varchar` severity column to the Severity union.
+ * The column is typed `string` by the schema, so callers must prove the value
+ * is one of the four levels before it can be used as a Severity.
+ */
+function isSeverity(value: unknown): value is Severity {
+  return typeof value === 'string' && (SEVERITY_LEVELS as readonly string[]).includes(value);
+}
