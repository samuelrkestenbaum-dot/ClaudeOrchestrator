@@ -141,6 +141,18 @@ const SEVERITY_ORDER: Record<string, number> = {
   'critical': 4,
 };
 
+type Severity = AutoApplyConfig['maxSeverity'];
+
+const SEVERITY_LEVELS: readonly Severity[] = ['low', 'medium', 'high', 'critical'];
+
+/**
+ * The DB column is a plain varchar, so narrow it to the severity union at the
+ * boundary. Anything unrecognised (or null) falls back to the safe default.
+ */
+function toSeverity(value: string | null | undefined, fallback: Severity = 'medium'): Severity {
+  return SEVERITY_LEVELS.find(level => level === value) ?? fallback;
+}
+
