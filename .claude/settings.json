{
  "permissions": {
    "allow": [
      "mcp__21st__search",
      "mcp__21st__get_component",
      "mcp__21st-dev__search",
      "mcp__21st-dev__get_component"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-build-os.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-router.sh"
          }
        ]
      }
    ]
  }
}
